{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "skipLibCheck": true,
    "types": ["node", "bun"],
    "allowImportingTsExtensions": true
  },
  "include": ["apps", "packages", "scripts", "tests/**/*.tsx", "drizzle.config.ts"]
}
