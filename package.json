{
  "name": "harnesshub",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.18.0 <25",
    "bun": "1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/daemon/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun scripts/test.ts",
    "install:local": "bun scripts/install-local.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.99.1",
    "@agentclientprotocol/codex-acp": "2.5.0",
    "@agentclientprotocol/sdk": "2.2.0",
    "@hono/node-server": "2.1.5",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "solid-js": "1.9.18",
    "ws": "8.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/bun": "1.3.14",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  },
  "trustedDependencies": [
    "better-sqlite3"
  ]
}
